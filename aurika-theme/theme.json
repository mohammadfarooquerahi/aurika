{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": true,
      "customGradient": true,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "name": "Black",
          "slug": "black",
          "color": "#111111"
        },
        {
          "name": "Dark",
          "slug": "dark",
          "color": "#1a1a1a"
        },
        {
          "name": "Gold",
          "slug": "gold",
          "color": "#b8860b"
        },
        {
          "name": "Gold Light",
          "slug": "gold-light",
          "color": "#d4a017"
        },
        {
          "name": "Ivory",
          "slug": "ivory",
          "color": "#f7f4ef"
        },
        {
          "name": "Cream",
          "slug": "cream",
          "color": "#faf8f5"
        },
        {
          "name": "Border",
          "slug": "border",
          "color": "#e8e0d5"
        },
        {
          "name": "White",
          "slug": "white",
          "color": "#ffffff"
        },
        {
          "name": "Muted Gray",
          "slug": "gray",
          "color": "#666666"
        }
      ]
    },
    "typography": {
      "customFontSize": true,
      "fontFamilies": [
        {
          "name": "Playfair Display",
          "slug": "playfair-display",
          "fontFamily": "'Playfair Display', Georgia, serif"
        },
        {
          "name": "Poppins",
          "slug": "poppins",
          "fontFamily": "'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "slug": "small",
          "size": "13px"
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "16px"
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "24px"
        },
        {
          "name": "Extra Large",
          "slug": "x-large",
          "size": "36px"
        },
        {
          "name": "Huge",
          "slug": "huge",
          "size": "48px"
        }
      ]
    },
    "layout": {
      "contentSize": "800px",
      "wideSize": "1340px"
    },
    "spacing": {
      "units": ["px", "em", "rem", "%", "vh", "vw"],
      "margin": true,
      "padding": true
    }
  },
  "styles": {
    "color": {
      "background": "#ffffff",
      "text": "#1a1a1a"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--poppins)",
      "fontSize": "16px",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--playfair-display)",
          "fontWeight": "700"
        },
        "color": {
          "text": "#111111"
        }
      },
      "link": {
        "color": {
          "text": "inherit"
        },
        ":hover": {
          "color": {
            "text": "#b8860b"
          }
        }
      },
      "button": {
        "appearance": "none",
        "color": {
          "background": "#111111",
          "text": "#ffffff"
        },
        "border": {
          "radius": "50px"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--poppins)",
          "fontSize": "12px",
          "fontWeight": "700",
          "letterSpacing": "2px",
          "textTransform": "uppercase"
        },
        ":hover": {
          "color": {
            "background": "#b8860b",
            "text": "#ffffff"
          }
        }
      }
    }
  }
}
